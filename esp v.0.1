#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

#define DHTPIN 4      // Пин, к которому подключен датчик DHT (GPIO4)
#define DHTTYPE DHT11 // Тип датчика (DHT11 или DHT22)

#define LED1 5        // Пин для первого светодиода (GPIO5)
#define LED2 18       // Пин для второго светодиода (GPIO18)
#define FAN 19        // Пин для управления кулером (GPIO19)

DHT dht(DHTPIN, DHTTYPE);

const char* ssid = "your_SSID";     // Замените на имя вашей Wi-Fi сети
const char* password = "your_PASSWORD"; // Замените на пароль вашей Wi-Fi сети

WebServer server(80);

float temperature = 0;
float humidity = 0;

void setup() {
  Serial.begin(115200);
  delay(10);

  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(FAN, OUTPUT);

  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);
  digitalWrite(FAN, LOW);

  dht.begin();

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Connecting to WiFi...");
  }
  Serial.println("Connected to WiFi");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/led1", handleLED1);
  server.on("/led2", handleLED2);
  server.on("/fan", handleFan);

  server.begin();
  Serial.println("HTTP server started");
}

void loop() {
  server.handleClient();
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();
  delay(2000);
}

void handleRoot() {
  String html = "<html><body>";
  html += "<h1>ESP32 Web Server</h1>";
  html += "<p>Temperature: " + String(temperature) + " C</p>";
  html += "<p>Humidity: " + String(humidity) + " %</p>";
  html += "<p><a href=\"/led1?state=on\">Turn LED1 ON</a> <a href=\"/led1?state=off\">Turn LED1 OFF</a></p>";
  html += "<p><a href=\"/led2?state=on\">Turn LED2 ON</a> <a href=\"/led2?state=off\">Turn LED2 OFF</a></p>";
  html += "<p><a href=\"/fan?state=on\">Turn FAN ON</a> <a href=\"/fan?state=off\">Turn FAN OFF</a></p>";
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handleData() {
  String data = "Temperature: " + String(temperature) + " C, Humidity: " + String(humidity) + " %";
  server.send(200, "text/plain", data);
}

void handleLED1() {
  if (server.arg("state") == "on") {
    digitalWrite(LED1, HIGH);
    server.send(200, "text/plain", "LED1 ON");
  } else if (server.arg("state") == "off") {
    digitalWrite(LED1, LOW);
    server.send(200, "text/plain", "LED1 OFF");
  }
}

void handleLED2() {
  if (server.arg("state") == "on") {
    digitalWrite(LED2, HIGH);
    server.send(200, "text/plain", "LED2 ON");
  } else if (server.arg("state") == "off") {
    digitalWrite(LED2, LOW);
    server.send(200, "text/plain", "LED2 OFF");
  }
}

void handleFan() {
  if (server.arg("state") == "on") {
    digitalWrite(FAN, HIGH);
    server.send(200, "text/plain", "FAN ON");
  } else if (server.arg("state") == "off") {
    digitalWrite(FAN, LOW);
    server.send(200, "text/plain", "FAN OFF");
  }
}
