  html += "  });";
  html += "}";


  html += "function togglePump() {";
  html += "  fetch('/togglePump').then(response => response.text()).then(text => {";
  html += "    document.getElementById('pumpStatus').innerText = text.trim();";
  html += "  });";
  html += "}";

  html += "setInterval(updateData, 1000);"; 
  html += "</script>";
  html += "</head><body>";
  html += "<h1>ESP32 Web Server</h1>";
  html += "<p>Температура: <span id='temperature'>" + String(temperature) + " C</span></p>";
  html += "<p>Влажность: <span id='humidity'>" + String(humidity) + " %</span></p>";
  html += "<p>Движение: <span id='motion'>" + String(motionDetected ? "Обнаружено" : "Нет движения") + "</span></p>";
  html += "<p>Дым: <span id='smoke'>" + String(smokeDetected ? "Обнаружен" : "Не обнаружен") + "</span></p>";
  html += "<p>Протечка: <span id='leak'>" + String(leakDetected ? "Обнаружена" : "Не обнаружена") + "</span></p>";
  html += "<p>Порог вентилятора: <span id='fanThreshold'>" + String(fanThresholdTemperature) + " C</span></p>";
  html += "<p>Режим: <span id='autoMode'>" + String(autoMode ? "Автоматический" : "Ручной") + "</span></p>";
  html += "<p><button onclick='toggleLED1()'>Переключить LED1</button> Статус: <span id='led1Status'>" + String(led1State ? "ВКЛ" : "ВЫКЛ") + "</span></p>";
  html += "<p><button onclick='toggleLED2()'>Переключить LED2</button> Статус: <span id='led2Status'>" + String(led2State ? "ВКЛ" : "ВЫКЛ") + "</span></p>";
  html += "<p><button onclick='toggleFan()'>Переключить ВЕНТИЛЯТОР</button> Статус: <span id='fanStatus'>" + String(fanState ? "ВКЛ" : "ВЫКЛ") + "</span></p>";
  html += "<p><button onclick='togglePump()'>Переключить ПОМПУ</button> Статус: <span id='pumpStatus'>" + String(pumpState ? "ВКЛ" : "ВЫКЛ") + "</span></p>";
  html += "<p><button onclick='toggleAutoMode()'>Переключить авторежим</button></p>";
  html += "<p><input type='number' id='fanThresholdInput' placeholder='Введите порог температуры для вентилятора'>";
  html += "<button onclick='setFanThreshold()'>Установить порог вентилятора</button></p>";
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handleData() {
  String data = "{";
  data += "\"temperature\": " + String(temperature) + ",";
  data += "\"humidity\": " + String(humidity) + ",";
  data += "\"motion\": \"" + String(motionDetected ? "Обнаружено" : "Нет движения") + "\",";
  data += "\"smoke\": \"" + String(smokeDetected ? "Обнаружен" : "Не обнаружен") + "\",";
  data += "\"leak\": \"" + String(leakDetected ? "Обнаружена" : "Не обнаружена") + "\",";
  data += "\"fanThreshold\": " + String(fanThresholdTemperature) + ",";
  data += "\"autoMode\": " + String(autoMode ? "true" : "false") + ",";
  data += "\"led1State\": " + String(led1State ? "true" : "false") + ",";
  data += "\"led2State\": " + String(led2State ? "true" : "false") + ",";
  data += "\"fanState\": " + String(fanState ? "true" : "false") + ",";
  data += "\"pumpState\": " + String(pumpState ? "true" : "false");
  data += "}";
  server.send(200, "application/json", data);
}

void handleToggleLED1() {
  led1State = !led1State;
  digitalWrite(LED1, led1State ? HIGH : LOW);
  server.send(200, "text/plain", led1State ? "ВКЛ" : "ВЫКЛ");
}

void handleToggleLED2() {
  led2State = !led2State;
  digitalWrite(LED2, led2State ? HIGH : LOW);
  server.send(200, "text/plain", led2State ? "ВКЛ" : "ВЫКЛ");
}

void handleToggleFan() {
  fanState = !fanState;
  digitalWrite(FAN, fanState ? HIGH : LOW);
  server.send(200, "text/plain", fanState ? "ВКЛ" : "ВЫКЛ");
}

void handleSetFanThreshold() {
  if (server.hasArg("threshold")) {
    float newThreshold = server.arg("threshold").toFloat();
    if (newThreshold >= 0) { 
      fanThresholdTemperature = newThreshold;
      server.send(200, "text/plain", "Порог вентилятора установлен на " + String(fanThresholdTemperature) + " C");
    } else {
      server.send(400, "text/plain", "Неверное значение порога");
    }
  } else {
    server.send(400, "text/plain", "Отсутствует параметр порога");
  }
}


void handleToggleAutoMode() {
  autoMode = !autoMode; 
  server.send(200, "text/plain", "Режим управления " + String(autoMode ? "автоматический" : "ручной"));
}

void handleTogglePump() {
  pumpState = !pumpState;
  digitalWrite(PUMP_PIN, pumpState ? HIGH : LOW);
  server.send(200, "text/plain", pumpState ? "ВКЛ" : "ВЫКЛ");
}
