  String html = "<html><head><meta charset='UTF-8'>";
  html += "<title>ESP32 Web Server</title>";
  html += "<script>";
  html += "function updateData() {";
  html += "  fetch('/data').then(response => response.json()).then(data => {";
  html += "    document.getElementById('temperature').innerText = data.temperature + ' C';";
  html += "    document.getElementById('humidity').innerText = data.humidity + ' %';";
  html += "    document.getElementById('motion').innerText = data.motion;";
  html += "    document.getElementById('smoke').innerText = data.smoke;";
  html += "    document.getElementById('leak').innerText = data.leak;";
  html += "    document.getElementById('fanThreshold').innerText = data.fanThreshold + ' C';";
  html += "    document.getElementById('autoMode').innerText = data.autoMode ? 'Автоматический' : 'Ручной';";
  html += "    document.getElementById('led1Status').innerText = data.led1State ? 'ВКЛ' : 'ВЫКЛ';";
  html += "    document.getElementById('led2Status').innerText = data.led2State ? 'ВКЛ' : 'ВЫКЛ';";
  html += "    document.getElementById('fanStatus').innerText = data.fanState ? 'ВКЛ' : 'ВЫКЛ';";
  html += "    document.getElementById('pumpStatus').innerText = data.pumpState ? 'ВКЛ' : 'ВЫКЛ';";
  html += "  });";
  html += "}";

  html += "function toggleLED1() {";
  html += "  fetch('/toggleLED1').then(response => response.text()).then(text => {";
  html += "    document.getElementById('led1Status').innerText = text.trim();";
  html += "  });";
  html += "}";

  html += "function toggleLED2() {";
  html += "  fetch('/toggleLED2').then(response => response.text()).then(text => {";
  html += "    document.getElementById('led2Status').innerText = text.trim();";
  html += "  });";
  html += "}";

  html += "function toggleFan() {";
  html += "  fetch('/toggleFan').then(response => response.text()).then(text => {";
  html += "    document.getElementById('fanStatus').innerText = text.trim();";
  html += "  });";
  html += "}";

  html += "function setFanThreshold() {";
  html += "  const threshold = document.getElementById('fanThresholdInput').value;";
  html += "  fetch('/setFanThreshold?threshold=' + threshold).then(response => response.text()).then(text => {";
  html += "    alert(text);";
