#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

#define DHTPIN 4      // Пин, к которому подключен датчик DHT
#define DHTTYPE DHT11 // Тип датчика (DHT11 или DHT22)

#define LED1 5        // Пин для первого светодиода
#define LED2 18       // Пин для второго светодиода
#define FAN 19        // Пин для управления кулером
#define PIR_PIN 23    // Пин для датчика движения HC-SR501
#define GAS_SENSOR_PIN 34  // Датчик дыма MQ-2 
#define RAIN_SENSOR_PIN 35  // Датчик протечки (MH-RD) на GPIO35 (D35)
#define PUMP_PIN 27  // Реле для управления помпой на GPIO27

#define RAIN_THRESHOLD 3000  // Порог срабатывания (чем ниже, тем больше воды)

DHT dht(DHTPIN, DHTTYPE);

const char* ssid = "Vardges";    
const char* password = "12345678"; 

WebServer server(80);

float temperature = 0;
float humidity = 0;
bool motionDetected = false;
int gasValue = 0;  // Значение с датчика дыма
bool smokeDetected = false;  // Флаг обнаружения дыма
int rainValue = 0;  // Значение с датчика протечки
bool leakDetected = false;  // Флаг обнаружения протечки

// Состояние устройств
bool led1State = false;
bool led2State = false;
bool fanState = false;
bool pumpState = false;  // Состояние помпы

// Пороговые значения для автоматического управления
float fanThresholdTemperature = 30.0; // По умолчанию 30°C
int smokeThreshold = 900;  // Порог для обнаружения дыма

// Режим управления (true - автоматический, false - ручной)
bool autoMode = false;

// Переменная для отслеживания времени включения LED2
unsigned long led2TurnOnTime = 0;

void setup() {
  Serial.begin(115200);
  delay(10);

  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(FAN, OUTPUT);
  pinMode(PIR_PIN, INPUT);
  pinMode(GAS_SENSOR_PIN, INPUT);
  pinMode(RAIN_SENSOR_PIN, INPUT);
  pinMode(PUMP_PIN, OUTPUT);

  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);
  digitalWrite(FAN, LOW);
  digitalWrite(PUMP_PIN, HIGH);  // Помпа выключена по умолчанию

  dht.begin();

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Подключение к WiFi...");
  }
  Serial.println("Подключено к WiFi");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/toggleLED1", handleToggleLED1);
  server.on("/toggleLED2", handleToggleLED2);
  server.on("/toggleFan", handleToggleFan);
  server.on("/setFanThreshold", handleSetFanThreshold);
  server.on("/toggleAutoMode", handleToggleAutoMode); 
  server.on("/togglePump", handleTogglePump);  // Добавлен обработчик для помпы

  server.begin();
  Serial.println("HTTP сервер запущен");
}

void loop() {
  server.handleClient();
  
  static unsigned long lastSensorUpdate = 0;
  if (millis() - lastSensorUpdate >= 2000) { // Обновление данных каждые 2 секунды
    lastSensorUpdate = millis();

    float newTemperature = dht.readTemperature();
    float newHumidity = dht.readHumidity();

    if (!isnan(newTemperature)) {
      temperature = newTemperature;
    } else {
      Serial.println("Ошибка чтения температуры!");
    }

    if (!isnan(newHumidity)) {
      humidity = newHumidity;
    } else {
      Serial.println("Ошибка чтения влажности!");
    }

    gasValue = analogRead(GAS_SENSOR_PIN);  // Чтение значения с датчика дыма
    smokeDetected = gasValue > smokeThreshold;

    rainValue = analogRead(RAIN_SENSOR_PIN);  // Чтение значения с датчика протечки
    leakDetected = rainValue < RAIN_THRESHOLD;

    // Управление устройствами в автоматическом режиме
    if (autoMode) {
      // Управление вентилятором
      if (temperature > fanThresholdTemperature) {
        digitalWrite(FAN, HIGH); 
        fanState = true;
      } else {
        digitalWrite(FAN, LOW); 
        fanState = false;
      }


      // Управление помпой
      if (leakDetected) {
        Serial.println("⚠️ ПРОТЕЧКА ОБНАРУЖЕНА! ВЫКЛЮЧАЮ ПОМПУ!");
        digitalWrite(PUMP_PIN, LOW);  // Отключаем помпу
        pumpState = false;
      } else {
        Serial.println("✅ ПРОТЕЧКИ НЕТ. ПОМПА РАБОТАЕТ!");
        digitalWrite(PUMP_PIN, HIGH);  // Включаем помпу
        pumpState = true;
      }
    }

    // Обработка датчика движения
    bool currentMotionDetected = digitalRead(PIR_PIN) == HIGH;
    if (currentMotionDetected && !motionDetected) {
      // Движение обнаружено впервые
      motionDetected = true;
      digitalWrite(LED2, HIGH);  // Включаем LED2
      led2State = true;
      led2TurnOnTime = millis();  // Запоминаем время включения
      Serial.println("Движение обнаружено, LED2 включен");
    } else if (!currentMotionDetected && motionDetected) {
      // Движение прекратилось
      motionDetected = false;
      Serial.println("Движение прекратилось");
    }

    // Выключение LED2 через 10 секунд
    if (led2State && (millis() - led2TurnOnTime >= 10000)) {
      digitalWrite(LED2, LOW);  // Выключаем LED2
      led2State = false;
      Serial.println("LED2 выключен через 10 секунд");
    }

    if (smokeDetected) {
      Serial.println("⚠️ ДЕТЕКЦИЯ ДЫМА! ОПАСНО!");
    } else {
      Serial.println("✅ Дым не обнаружен.");
    }
  }
}

